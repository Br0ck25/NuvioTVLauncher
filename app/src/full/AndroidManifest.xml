<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the in-app updater install its own updates without a confirmation screen on Android 12+. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Granted once via the on-device Wireless debugging setup so the app can keep its own
         accessibility service enabled. Never available to a normal install without that grant. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application>
        <service
            android:name=".updater.UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".updater.UpdateInstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
